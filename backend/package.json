{
  "name": "lmbs-backend",
  "version": "1.1.0",
  "description": "Land Management Blockchain System backend API: auth, off-chain documents, chain indexer (read models)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "gen:secrets": "node scripts/generate-env.js",
    "create-admin": "node scripts/create-admin.js",
    "e2e": "node scripts/e2e-full-stack.js",
    "lint": "eslint ."
  },
  "keywords": [
    "lmbs",
    "lesotho",
    "blockchain",
    "land-registry"
  ],
  "author": "Karabo Nkhahle",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "middleware/**/*.js",
      "services/{authService,chainService,documentStore,cryptoService,indexerService}.js",
      "config/env.js"
    ]
  }
}
