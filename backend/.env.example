# LMBS backend configuration.
# Copy to .env (never commit .env). Generate the three secrets with:
#   npm run gen:secrets        (writes .env with fresh random values)
# The server REFUSES TO START if a secret is missing, too short or a placeholder.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── MongoDB (off-chain data: users, documents metadata, chain read models) ───
MONGODB_URI=mongodb://127.0.0.1:27017/lmbs_db
MONGODB_DB_NAME=lmbs_db

# ── Secrets (64 hex chars each: openssl rand -hex 32) ─────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=
PSEUDONYM_SALT=
JWT_TTL_MINUTES=30

# ── Blockchain (Hyperledger Besu QBFT) ───────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=2026
# Written by `npm run deploy:besu` in ../blockchain
CHAIN_DEPLOYMENT_FILE=chain/deployment.besu.json
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=4000

# ── Encrypted document store ─────────────────────────────────────────────────
DOCUMENT_STORE_DIR=storage/documents
MAX_DOCUMENT_BYTES=10485760
