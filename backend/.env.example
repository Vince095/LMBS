# Copy this file to .env and fill in the values before starting the backend.
# NEVER commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Atlas connection string (production)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Local dev fallback
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/lms_blockchain

# Database name
MONGODB_DB_NAME=lmbs_db

# ── Encryption ────────────────────────────────────────────────────────────────
# 64-character hex string  (openssl rand -hex 32)
ENCRYPTION_KEY=<generate_with_openssl_rand_hex_32>

# ── Blockchain (Hyperledger Besu / Ganache) ───────────────────────────────────
# Leave blank in dev — the system falls back to synthetic TX hashes
BESU_RPC_URL=
BESU_CHAIN_ID=1337
